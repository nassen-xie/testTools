// サイドメニュー：基本テンプレートのサイドメニュー（sidebar）に表示する項目（画面とグループ）を &Menu に入れる。
// 画面の表示のたびに呼ばれる（ScriptMenuAdvice）。画面を追加したら、ここに 1 行足す。
//   画面    ：Screen(画面ID, 名前, アイコン)。URL は /画面ID
//   グループ：Group(名前, アイコン)。中の項目は &グループ.Children.Add(…)（グループの中にグループも置ける）。最初は閉じていて、クリックで開閉する
Sub Call
    &Menu.Clear()
    &Menu.Add(Screen("CustomerMasterList", "取引先マスタ一覧", "📄"))
    &Menu.Add(Screen("CustomerMasterList_copy", "取引先マスタ一覧_copy", "📄"))
    &Menu.Add(Screen("newscreen", "newscreen", "📄"))

    &Menu.Add(Screen("demoScreen", "デモ画面", "📄"))
    &Menu.Add(Screen("listScreen2", "一覧画面2", "📄"))

    // グループ1（中に 一覧画面3・一覧画面4 と グループ2）
    &group1 = Group("グループ1", "📁")
    &group1.Children.Add(Screen("listScreen3", "一覧画面3", "📄"))
    &group1.Children.Add(Screen("listScreen4", "一覧画面4", "📄"))

    // グループ2（グループ1 の中。中に 一覧画面5・一覧画面6）
    &group2 = Group("グループ2", "📁")
    &group2.Children.Add(Screen("listScreen5", "一覧画面5", "📄"))
    &group2.Children.Add(Screen("listScreen6", "一覧画面6", "📄"))
    &group1.Children.Add(&group2)

    &Menu.Add(&group1)
End Sub

// 画面の項目：画面ID・名前・アイコン（URL は /画面ID）
Function Screen(&key, &caption, &icon) As MenuItem
    &item.Key = &key
    &item.Caption = &caption
    &item.Url = "/" + &key
    &item.Icon = &icon
    Return &item
End Function

// グループ：名前・アイコン（中の項目は Children に追加する）
Function Group(&caption, &icon) As MenuItem
    &item.Caption = &caption
    &item.Icon = &icon
    Return &item
End Function

// 捕まえていないエラー（処理の後で呼び出し元にエラーを渡す。DB の処理は書けない）
Event Module.Error(ex)
    CommonError.Call(ex)
End Event
