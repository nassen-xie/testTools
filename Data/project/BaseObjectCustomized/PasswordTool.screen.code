Event Form.Load
    If Not IsDevMode() Then
        Throw "このページは開発環境（application.properties の app.dev が true）でだけ使えます。"
    End If
End Event

Event btnHash.Click
    &hash = PasswordHash(&plain)
    Msg("ハッシュを作りました。ユーザーのテーブルのパスワードの列にコピーしてください（毎回違う値になります）。")
End Event

Event btnCheck.Click
    If PasswordMatches(&plain, &hash) Then
        Msg("パスワードとハッシュは一致します。")
    Else
        Msg(MsgLevel.Error, "パスワードとハッシュは一致しません。")
    End If
End Event
