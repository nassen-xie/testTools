// テンプレートのコード（画面の BaseLayout でこのテンプレートを選ぶと、画面のコードの最後にコピーする。文法は Docoment/语法示例.xlsx）
// 画面と同じ名前の Event・Sub・Function は書けません（画面の Form.Load で処理する場合は Sub を作り、画面から呼びます）。

Event Form.Load

    If &piTrnMode = TrnMode.NEW  Then
        &Customer.Clear()
    Else
        &Customer.Load(&piCustomerCd)
    End If

End Event

Event btnOk.Click
    If &piTrnMode = TrnMode.NEW  Then
        &Customer.Insert()
    Else
        &Customer.Update()
    End If
    Commit
End Event
