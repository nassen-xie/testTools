// テンプレートのコード
// 画面と同じ名前の Event・Sub・Function は書けません（画面の Form.Load で処理する場合は Sub を作り、画面から呼びます）。
Event Form.Load
    getData
    Log( "Form.Load")
End Event

Sub getData
    // &SampleUserInfos = getUsers.get(&pioUserCd)

    // 変数定義：&i
    For &i = 1 To 15
        &SampleEstimate_tmp.Clear()
        &SampleEstimate_tmp.EstimateCD = "10001" + &i
        &SampleEstimate_tmp.TransactionKbn = "田中　"
        &SampleEstimate_tmp.EstimateDate = Now
        &SampleEstimate_tmp.UserCD= "abcde@google.co.jp"
        &SampleEstimate_tmp.CustomerCD = "03-1234-5678"
        &SampleEstimate_tmp.Amount = &i *  &i
        &SampleEstimates.Add(&SampleEstimate_tmp)

    Next

    Log( "getData")
End Sub

Event btnClear.Click
    &SampleEstimate.Clear()
End Event

Event btnSearch.Click
    getData
    Log( " btnSearch.Click")
End Event

Event &SampleEstimates.btnDetail.Click
    SampleEstimateDetail.Call(TrnMode.VIEW, &SampleEstimates(row).EstimateCD, &tmpMessage)
End Event

Event &SampleEstimates.btnEdit.Click
    SampleEstimateDetail.Call(TrnMode.EDIT, &SampleEstimates(row).EstimateCD, &tmpMessage)
End Event

Event &SampleEstimates.btnCopy.Click
    SampleEstimateDetail.Call(TrnMode.COPY, &SampleEstimates(row).EstimateCD, &tmpMessage)
End Event

Event &SampleEstimates.btnDelete.Click
    SampleEstimateDetail.Call(TrnMode.DEL, &SampleEstimates(row).EstimateCD, &tmpMessage)
End Event

Event btnNew.Click
    SampleEstimateDetail.Call(TrnMode.NEW, Empty, &tmpMessage)
End Event

Event btnExport.Click
    SampleEstimateReport.Download("SampleEstimateReport.pdf", &estimate, &lines)
End Event

// ===== テンプレートのコードここまで =====
