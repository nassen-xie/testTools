  "code": [
    "// テンプレートのコード（画面の BaseLayout でこのテンプレートを選ぶと、画面のコードの最後にコピーする。文法は Docoment/语法示例.xlsx）",
    "// 画面と同じ名前の Event・Sub・Function は書けません（画面の Form.Load で処理する場合は Sub を作り、画面から呼びます）。",
    "",
    "Event Form.Load",
    "",
    "    If \u0026piTrnMode = TrnMode.NEW  Then",
    "        \u0026Customer.Clear()",
    "    Else",
    "        \u0026Customer.Load(\u0026piCustomerCd)",
    "    End If",
    "",
    "End Event",
    "",
    "Event btnOk.Click",
    "    If \u0026piTrnMode = TrnMode.NEW  Then",
    "        \u0026Customer.Insert()",
    "    Else",
    "        \u0026Customer.Update()",
    "    End If",
    "    Commit",
    "End Event",
    ""
  ]
