{
  "name": "OptimisticLockingCheck",
  "caption": "楽観排他の確認",
  "variables": [
    {
      "logicalName": "楽観排他の情報",
      "physicalName": "piOptimistic",
      "baseType": "Optimistic",
      "dataType": "",
      "scope": "interface",
      "isArray": false,
      "direction": "in"
    },
    {
      "logicalName": "結果（True：保存してよい）",
      "physicalName": "poResult",
      "baseType": "Boolean",
      "dataType": "BOOLEAN",
      "scope": "interface",
      "isArray": false,
      "direction": "out"
    },
    {
      "logicalName": "メッセージ（False のとき）",
      "physicalName": "poMessage",
      "baseType": "String(200)",
      "dataType": "VARCHAR(200)",
      "scope": "interface",
      "isArray": false,
      "direction": "out"
    }
  ],
  "interface": [
    {
      "logicalName": "楽観排他の情報",
      "physicalName": "piOptimistic",
      "baseType": "Optimistic",
      "dataType": "",
      "isArray": false,
      "direction": "in"
    },
    {
      "logicalName": "結果（True：保存してよい）",
      "physicalName": "poResult",
      "baseType": "Boolean",
      "dataType": "BOOLEAN",
      "isArray": false,
      "direction": "out"
    },
    {
      "logicalName": "メッセージ（False のとき）",
      "physicalName": "poMessage",
      "baseType": "String(200)",
      "dataType": "VARCHAR(200)",
      "isArray": false,
      "direction": "out"
    }
  ],
  "code": [
    "// 楽観排他の確認（共通）：保存・削除の前に呼ぶ。",
    "//   inout \u0026piOptimistic    ：楽観排他の情報（表名・主キーの列と値・更新日時の列・更新者の列・読んだときの更新日時）。今の更新日時・更新者が入る",
    "//   out   \u0026poResult  ：True＝保存してよい（\u0026NewDate を更新日時に入れて保存する）、False＝保存しない（\u0026Message を表示する）",
    "//   out   \u0026poMessage ：False のときのメッセージ",
    "// 行はロックしない（確認から保存までの短い間に他の人が保存した場合は分からない。厳密にする場合は、先に LoadForUpdate で行をロックする）",
    "Sub Call",
    "    \u0026poResult = False",
    "    \u0026poMessage = \u0022\u0022",
    "",
    "    // 今の更新日時・更新者を読む（\u0026piOptimistic.CurrentDate・\u0026piOptimistic.CurrentUser）",
    "    OptimisticCheck(\u0026piOptimistic)",
    "    // 行がない：他の人が削除した",
    "    If \u0026piOptimistic.CurrentDate.IsEmpty Then",
    "        \u0026poMessage = \u0022他の人が削除しました。画面を開き直してください。\u0022",
    "        Exit Sub",
    "    End If",
    "",
    "    // 読んだ後に他の人が更新した",
    "    If \u0026piOptimistic.CurrentDate \u003C\u003E \u0026piOptimistic.ReadDate Then",
    "        If \u0026piOptimistic.CurrentUser.IsEmpty Then",
    "            \u0026poMessage = Format(\u0022%1 に他の人が先に更新しました。画面を開き直してから、もう一度入力してください。\u0022, Format(\u0026piOptimistic.CurrentDate, \u0022yyyy/MM/dd HH:mm:ss\u0022))",
    "        Else",
    "            \u0026poMessage = Format(\u0022%1 に %2 さんが先に更新しました。画面を開き直してから、もう一度入力してください。\u0022, Format(\u0026piOptimistic.CurrentDate, \u0022yyyy/MM/dd HH:mm:ss\u0022), \u0026piOptimistic.CurrentUser)",
    "        End If",
    "",
    "        Log(LogLevel.Info, \u0022排他エラー\u0022, \u0026piOptimistic)",
    "        Exit Sub",
    "    End If",
    "",
    "    \u0026poResult = True",
    "End Sub",
    ""
  ]
}
